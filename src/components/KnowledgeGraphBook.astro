---
/*
 * KnowledgeGraphBook.astro — Pagina dedicata al libro
 * "AI che Ragiona" / "AI that Reasons", in italiano e in inglese.
 * Usata da src/pages/books/knowledge-graph.astro (IT) e
 * src/pages/en/books/knowledge-graph.astro (EN).
 *
 * Formati: Paperback, Hardcover, eBook Kindle
 */

import Navbar from './Navbar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from './Footer.astro';
import { AMAZON_BOOK_URL } from '../links';

interface Props {
  lang?: 'it' | 'en';
}
const { lang = 'it' } = Astro.props;

const GITHUB_DISCUSSIONS_URL = 'https://github.com/orgs/agent-engineering-studio/discussions';

const COMING_SOON = false;

const stack = ['Python 3.11+', 'Neo4j', 'Redis Stack', 'Ollama (qwen2.5:14b + nomic-embed-text)', 'FastMCP', 'Microsoft Agent Framework', 'FastAPI', 'Next.js', 'Docker Compose'];

const content = {
  it: {
    metaTitle: 'AI che Ragiona — Agent Engineering Studio',
    metaDesc: 'Oltre 400 pagine di codice Python eseguibile per costruire Knowledge Graph enterprise, pipeline Graph-RAG ibride, server MCP e crew di agenti orchestrati con Microsoft Agent Framework. Dalla teoria al deployment, senza scorciatoie.',
    canonical: 'https://agentengineering.it/books/knowledge-graph',
    altLangHref: '/en/books/knowledge-graph',
    amazonUrl: AMAZON_BOOK_URL.it,
    cover: '/covers/ai-che-ragiona-it-ebook-cover.jpg',
    badge: 'Edizione 2026',
    title: 'AI che Ragiona',
    titleAccent: 'Da sviluppatore a Solution Architect',
    subtitle: 'Knowledge Graph, Graph-RAG e Agenti Multi-Modello in Produzione con Python, Neo4j, MCP e Microsoft Agent Framework.',
    by: 'di',
    coverAlt: 'Copertina: AI che Ragiona',
    soonTitle: 'Presto disponibile su Amazon',
    soonDesc: 'Il libro è in revisione editoriale. I link di acquisto saranno attivati subito dopo la pubblicazione.',
    aboutTitle: 'Di cosa parla il libro',
    aboutLead: 'Le chatbot rispondono. I sistemi che ragionano decidono.',
    aboutBody: [
      "La maggior parte dei libri sull'AI si ferma al notebook Jupyter. <strong>Questo no.</strong> Ogni riga di codice è stata scritta, eseguita e messa in produzione — puoi farlo anche tu, sulla tua macchina, stasera. Fai <code>git clone</code> del repository e nel giro di un caffè avrai il tuo primo Knowledge Graph in esecuzione.",
      "<strong>AI che Ragiona</strong> colma il divario fra teoria accademica e sistema enterprise che paga le bollette. Oltre <strong>400 pagine</strong> di codice Python eseguibile, architetture di produzione e uno <strong>studio di caso end-to-end da 18 mesi</strong>.",
      "Dai <strong>Knowledge Graph</strong> — la stessa tecnologia dietro al grafo Google da 1,6 trilioni di triple — alle due evoluzioni che nel 2025-2026 ridefiniscono come l'AI viene progettata e venduta: il <strong>Model Context Protocol</strong> di Anthropic e l'<strong>orchestrazione multi-agente</strong> con Microsoft Agent Framework. Tutto eseguibile con un singolo <code>docker compose up</code>.",
      "Pensato per <strong>developer Python, AI/ML engineer e architect</strong> che cercano codice completo e pattern di produzione, ma anche per <strong>chi affianca team e progetti AI</strong> e cerca casi d'uso concreti per settore.",
    ],
    tocTitle: 'Struttura del libro',
    partLabel: 'Parte',
    chapLabel: 'Cap.',
    parts: [
      { number: 'I', title: 'Fondamenti dei Knowledge Graph', chapters: '1-4', desc: 'Teoria KG, modelli dati (RDF, Property Graph), query Cypher/SPARQL, ontologie OWL e ragionamento' },
      { number: 'II', title: 'Costruire con Python', chapters: '5-12', desc: 'Quick Start in 30 min, architettura, pipeline ingestion, Docker Compose, Pydantic, Vector Store' },
      { number: 'III-V', title: 'RAG, KGC e Pipeline', chapters: '13-20', desc: 'Graph-RAG vs RAG classico, ricerca ibrida, KG Completion, pipeline da testo, metriche qualità' },
      { number: 'VI', title: 'Model Context Protocol', chapters: '21-24', desc: 'Architettura MCP, server per KG, tool custom, sicurezza enterprise, debug' },
      { number: 'VII+', title: 'Agent AI e Business', chapters: '25-32', desc: '7 agenti orchestrati con MAF, confronto framework, pricing, ROI, deployment cloud enterprise' },
    ],
    stackTitle: 'Stack Tecnologico',
    highlights: [
      { icon: '📖', label: '400+ pagine full color' },
      { icon: '💻', label: 'Codice Python eseguibile' },
      { icon: '🏗️', label: 'Architetture enterprise reali' },
      { icon: '🤖', label: '7 agenti orchestrati con MAF' },
      { icon: '🔗', label: 'MCP + Knowledge Graph' },
      { icon: '📊', label: 'Caso reale end-to-end di 18 mesi' },
    ],
    formatsTitle: 'Formati disponibili',
    formats: [
      { icon: '📖', title: 'Paperback', details: ['7" × 10" — Full color', 'Carta bianca premium, copertina lucida'] },
      { icon: '📕', title: 'Hardcover', details: ['7" × 10" — Full color', 'Copertina rigida, dorso stampato'] },
      { icon: '📱', title: 'eBook Kindle', details: ['EPUB 3.0 — Reflowable', 'TOC navigabile, 35 figure'] },
    ],
    audienceTitle: 'Per chi è',
    audiences: [
      {
        title: 'Developer & Engineer',
        desc: 'Per chi scrive codice e progetta architetture.',
        items: ['Developer Python', 'AI/ML engineer', 'Software architect', 'Data engineer e platform engineer'],
      },
      {
        title: 'Decision maker',
        desc: 'Per chi decide cosa portare in produzione e con quale budget.',
        items: ['CTO e Head of Engineering', 'Product Manager e AI Product Lead', 'Consulenti AI e founder', 'Innovation manager enterprise'],
      },
    ],
    bonusTitle: 'Bonus inclusi',
    bonusIntro: "Il libro non finisce all'ultima pagina. Ogni copia include risorse pratiche per accelerare il lavoro su progetti reali.",
    bonuses: [
      { icon: '📦', label: 'Repository GitHub con i 5 moduli del progetto' },
      { icon: '📓', label: 'Jupyter Notebook per ogni capitolo' },
      { icon: '🐳', label: "Docker Compose pronto all'uso" },
      { icon: '📚', label: 'Glossario, Bibliografia, Cheat Sheet, Troubleshooting' },
      { icon: '📝', label: 'Template pronti: ADR, SOW, business case, RFP' },
      { icon: '🇪🇺', label: 'Sezione compliance: GDPR, EU AI Act, ISO/IEC 42001' },
    ],
    authorTitle: "L'autore",
    authorBio: "Sviluppatore software da oltre vent'anni. In <strong>Hevolus</strong> guida la AI Engineering Unit. Il suo lavoro ha portato XR Copilot powered by Microsoft AI Foundry a integrare Knowledge Graph, GenAI ed Extended Reality in soluzioni enterprise.",
    authorQuote: "\"Wikipedia spiega cos'è un Knowledge Graph. YouTube mostra come fare una demo. Questo libro risponde alla domanda diversa, e molto più difficile: come si costruisce un sistema che funziona davvero in produzione e che qualcuno è disposto a pagare per usarlo.\"",
    communityTitle: 'Unisciti alla discussione',
    communityDesc: "Domande sul codice, idee, segnalazioni, casi d'uso reali: la conversazione continua sulle GitHub Discussions di Agent Engineering Studio.",
  },
  en: {
    metaTitle: 'AI that Reasons — Agent Engineering Studio',
    metaDesc: 'Over 400 pages of runnable Python code to build enterprise Knowledge Graphs, hybrid Graph-RAG pipelines, MCP servers and agent crews orchestrated with Microsoft Agent Framework. From theory to deployment, no shortcuts.',
    canonical: 'https://agentengineering.it/en/books/knowledge-graph',
    altLangHref: '/books/knowledge-graph',
    amazonUrl: AMAZON_BOOK_URL.en,
    cover: '/covers/ai-che-ragiona-en-ebook-cover.jpg',
    badge: '2026 Edition',
    title: 'AI that Reasons',
    titleAccent: 'From Developer to Solution Architect',
    subtitle: 'Knowledge Graphs, Graph-RAG and Multi-Model Agents in Production with Python, Neo4j, MCP and Microsoft Agent Framework.',
    by: 'by',
    coverAlt: 'Cover: AI that Reasons',
    soonTitle: 'Coming soon on Amazon',
    soonDesc: 'The book is in editorial review. Purchase links will go live right after publication.',
    aboutTitle: 'What the book is about',
    aboutLead: 'Chatbots reply. Systems that reason decide.',
    aboutBody: [
      "Most AI books stop at the Jupyter notebook. <strong>This one doesn't.</strong> Every line of code has been written, run and shipped to production — and you can do the same, on your own machine, tonight. Run <code>git clone</code> on the repository and within a coffee break your first Knowledge Graph will be up and running.",
      "<strong>AI that Reasons</strong> bridges the gap between academic theory and the enterprise system that pays the bills. Over <strong>400 pages</strong> of runnable Python code, production architectures and an <strong>18-month end-to-end case study</strong>.",
      "From <strong>Knowledge Graphs</strong> — the same technology behind Google's 1.6-trillion-triple graph — to the two shifts redefining how AI is designed and sold in 2025-2026: Anthropic's <strong>Model Context Protocol</strong> and <strong>multi-agent orchestration</strong> with Microsoft Agent Framework. All of it runs with a single <code>docker compose up</code>.",
      "Written for <strong>Python developers, AI/ML engineers and architects</strong> looking for complete code and production patterns, and also for <strong>people working alongside AI teams and projects</strong> who want concrete, industry-specific use cases.",
    ],
    tocTitle: 'Book structure',
    partLabel: 'Part',
    chapLabel: 'Ch.',
    parts: [
      { number: 'I', title: 'Knowledge Graph Foundations', chapters: '1-4', desc: 'KG theory, data models (RDF, Property Graph), Cypher/SPARQL queries, OWL ontologies and reasoning' },
      { number: 'II', title: 'Building with Python', chapters: '5-12', desc: '30-minute Quick Start, architecture, ingestion pipelines, Docker Compose, Pydantic, Vector Store' },
      { number: 'III-V', title: 'RAG, KGC and Pipelines', chapters: '13-20', desc: 'Graph-RAG vs classic RAG, hybrid search, KG Completion, text-to-graph pipelines, quality metrics' },
      { number: 'VI', title: 'Model Context Protocol', chapters: '21-24', desc: 'MCP architecture, KG servers, custom tools, enterprise security, debugging' },
      { number: 'VII+', title: 'AI Agents and Business', chapters: '25-32', desc: '7 agents orchestrated with MAF, framework comparison, pricing, ROI, enterprise cloud deployment' },
    ],
    stackTitle: 'Tech Stack',
    highlights: [
      { icon: '📖', label: '400+ full-color pages' },
      { icon: '💻', label: 'Runnable Python code' },
      { icon: '🏗️', label: 'Real enterprise architectures' },
      { icon: '🤖', label: '7 agents orchestrated with MAF' },
      { icon: '🔗', label: 'MCP + Knowledge Graph' },
      { icon: '📊', label: '18-month end-to-end real case' },
    ],
    formatsTitle: 'Available formats',
    formats: [
      { icon: '📖', title: 'Paperback', details: ['7" × 10" — Full color', 'Premium white paper, glossy cover'] },
      { icon: '📕', title: 'Hardcover', details: ['7" × 10" — Full color', 'Hard cover, printed spine'] },
      { icon: '📱', title: 'Kindle eBook', details: ['EPUB 3.0 — Reflowable', 'Navigable TOC, 35 figures'] },
    ],
    audienceTitle: "Who it's for",
    audiences: [
      {
        title: 'Developers & Engineers',
        desc: 'For those who write code and design architectures.',
        items: ['Python developers', 'AI/ML engineers', 'Software architects', 'Data and platform engineers'],
      },
      {
        title: 'Decision makers',
        desc: 'For those who decide what goes to production, and on what budget.',
        items: ['CTOs and Heads of Engineering', 'Product Managers and AI Product Leads', 'AI consultants and founders', 'Enterprise innovation managers'],
      },
    ],
    bonusTitle: 'Included bonuses',
    bonusIntro: "The book doesn't end on the last page. Every copy includes hands-on resources to speed up work on real projects.",
    bonuses: [
      { icon: '📦', label: 'GitHub repository with the 5 project modules' },
      { icon: '📓', label: 'A Jupyter Notebook for every chapter' },
      { icon: '🐳', label: 'Ready-to-use Docker Compose' },
      { icon: '📚', label: 'Glossary, Bibliography, Cheat Sheet, Troubleshooting' },
      { icon: '📝', label: 'Ready-made templates: ADR, SOW, business case, RFP' },
      { icon: '🇪🇺', label: 'Compliance section: GDPR, EU AI Act, ISO/IEC 42001' },
    ],
    authorTitle: 'The author',
    authorBio: 'Software developer for over twenty years. At <strong>Hevolus</strong> he leads the AI Engineering Unit. His work brought XR Copilot powered by Microsoft AI Foundry to integrate Knowledge Graphs, GenAI and Extended Reality into enterprise solutions.',
    authorQuote: '"Wikipedia explains what a Knowledge Graph is. YouTube shows you how to build a demo. This book answers a different, much harder question: how do you build a system that actually works in production, and that someone is willing to pay to use."',
    communityTitle: 'Join the discussion',
    communityDesc: 'Questions about the code, ideas, bug reports, real use cases: the conversation continues on the Agent Engineering Studio GitHub Discussions.',
  },
}[lang];

const t = content;
---

<BaseLayout
  lang={lang}
  title={t.metaTitle}
  description={t.metaDesc}
  canonical={t.canonical}
  altLangHref={t.altLangHref}
>
  <Navbar lang={lang} active="libri" altLangHref={t.altLangHref} />
  <main>
    <!-- Hero -->
    <section class="book-hero">
      <div class="container">

        <div class="book-hero__layout">
          <div class="book-hero__info">
            <span class="badge-new">{t.badge}</span>
            <h1 class="book-hero__title">
              {t.title}<br/>
              <span class="accent">{t.titleAccent}</span>
            </h1>
            <p class="book-hero__subtitle">{t.subtitle}</p>
            <p class="book-hero__author">
              {t.by} <strong>Giuseppe Zileni</strong>
            </p>

            {/* Amazon CTA — disabilitata finché il libro è in revisione */}
            {COMING_SOON ? (
              <div class="coming-soon-banner" role="status" aria-live="polite">
                <span class="coming-soon-banner__icon" aria-hidden="true">⏳</span>
                <div class="coming-soon-banner__body">
                  <strong class="coming-soon-banner__title">{t.soonTitle}</strong>
                  <span class="coming-soon-banner__desc">{t.soonDesc}</span>
                </div>
              </div>
            ) : (
              <>
                <div class="book-hero__badge-row">
                  <a
                    href={t.amazonUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Available at Amazon"
                  >
                    <img
                      src="/badges/available_at_amazon_en_vertical_wht.png"
                      alt="Available at Amazon"
                      class="amazon-badge-img"
                      width="220"
                      height="106"
                      loading="eager"
                    />
                  </a>
                </div>
                <p class="trademark">
                  Amazon's trademark is used under license from Amazon.com, Inc. or its affiliates.
                </p>
              </>
            )}
          </div>

          <!-- Book cover — real image -->
          <div class="book-hero__cover">
            <div class="cover-3d">
              <img
                src={t.cover}
                alt={t.coverAlt}
                class="cover-3d__img"
                width="320"
                height="512"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Highlights -->
    <section class="highlights">
      <div class="container">
        <div class="highlights__grid">
          {t.highlights.map((h) => (
            <div class="highlight-item">
              <span class="highlight-item__icon" aria-hidden="true">{h.icon}</span>
              <span class="highlight-item__label">{h.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Description -->
    <section class="description">
      <div class="container">
        <h2 class="section-title">{t.aboutTitle}</h2>
        <div class="description__content">
          <p class="lead">
            <em>{t.aboutLead}</em>
          </p>
          {t.aboutBody.map((p) => <p set:html={p} />)}
        </div>
      </div>
    </section>

    <!-- Table of contents -->
    <section class="toc">
      <div class="container">
        <h2 class="section-title">{t.tocTitle}</h2>
        <div class="toc__grid">
          {t.parts.map((part) => (
            <div class="toc-card">
              <div class="toc-card__header">
                <span class="toc-card__number">{t.partLabel} {part.number}</span>
                <span class="toc-card__chapters">{t.chapLabel} {part.chapters}</span>
              </div>
              <h3 class="toc-card__title">{part.title}</h3>
              <p class="toc-card__desc">{part.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Stack -->
    <section class="tech-stack">
      <div class="container">
        <h2 class="section-title">{t.stackTitle}</h2>
        <div class="stack-tags">
          {stack.map((tech) => (
            <span class="stack-tag">{tech}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- Formats -->
    <section class="formats">
      <div class="container">
        <h2 class="section-title">{t.formatsTitle}</h2>
        <div class="formats__grid">
          {t.formats.map((fmt) => (
            <div class="format-card">
              <span class="format-card__icon" aria-hidden="true">{fmt.icon}</span>
              <h3 class="format-card__title">{fmt.title}</h3>
              {fmt.details.map((d) => (
                <p class="format-card__detail">{d}</p>
              ))}
            </div>
          ))}
        </div>

        {/* Final CTA — disabilitato finché il libro è in revisione */}
        <div class="formats__cta">
          {COMING_SOON ? (
            <div class="coming-soon-banner coming-soon-banner--lg" role="status" aria-live="polite">
              <span class="coming-soon-banner__icon" aria-hidden="true">⏳</span>
              <div class="coming-soon-banner__body">
                <strong class="coming-soon-banner__title">{t.soonTitle}</strong>
                <span class="coming-soon-banner__desc">{t.soonDesc}</span>
              </div>
            </div>
          ) : (
            <>
              <a
                href={t.amazonUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Available at Amazon"
              >
                <img
                  src="/badges/available_at_amazon_en_vertical_wht.png"
                  alt="Available at Amazon"
                  class="amazon-badge-img amazon-badge-img--lg"
                  width="260"
                  height="125"
                  loading="lazy"
                />
              </a>
              <p class="trademark">
                Amazon's trademark is used under license from Amazon.com, Inc. or its affiliates.
              </p>
            </>
          )}
        </div>
      </div>
    </section>

    <!-- Audience -->
    <section class="audience">
      <div class="container">
        <h2 class="section-title">{t.audienceTitle}</h2>
        <div class="audience__grid">
          {t.audiences.map((aud) => (
            <div class="audience-card">
              <h3 class="audience-card__title">{aud.title}</h3>
              <p class="audience-card__desc">{aud.desc}</p>
              <ul class="audience-card__list">
                {aud.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Bonus -->
    <section class="bonuses">
      <div class="container">
        <h2 class="section-title">{t.bonusTitle}</h2>
        <p class="bonuses__intro">{t.bonusIntro}</p>
        <div class="bonuses__grid">
          {t.bonuses.map((b) => (
            <div class="bonus-item">
              <span class="bonus-item__icon" aria-hidden="true">{b.icon}</span>
              <span class="bonus-item__label">{b.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Autore -->
    <section class="author">
      <div class="container">
        <h2 class="section-title">{t.authorTitle}</h2>
        <div class="author__card">
          <div class="author__avatar" aria-hidden="true">GZ</div>
          <div class="author__body">
            <h3 class="author__name">Giuseppe Zileni</h3>
            <p class="author__bio" set:html={t.authorBio} />
            <p class="author__quote">
              <em>{t.authorQuote}</em>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Community / Discussions -->
    <section class="community">
      <div class="container">
        <a
          href={GITHUB_DISCUSSIONS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="community__card"
        >
          <div class="community__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="currentColor">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
          </div>
          <div class="community__body">
            <span class="community__eyebrow">Community</span>
            <h3 class="community__title">{t.communityTitle}</h3>
            <p class="community__desc">{t.communityDesc}</p>
          </div>
          <div class="community__arrow" aria-hidden="true">→</div>
        </a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  /* ── Back link ── */
  .back-link {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--color-accent); }

  /* ── Hero ── */
  .book-hero {
    padding: var(--space-3xl) 0 var(--space-2xl);
  }

  .book-hero__layout {
    display: flex;
    gap: var(--space-3xl);
    align-items: flex-start;
  }

  .book-hero__info {
    flex: 1;
  }

  .badge-new {
    display: inline-block;
    padding: 0.2em 0.8em;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-bg);
    background: var(--color-accent);
    border-radius: 999px;
    margin-bottom: var(--space-lg);
  }

  .book-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .accent { color: var(--color-accent); }

  .book-hero__subtitle {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 560px;
    margin-bottom: var(--space-md);
  }

  .book-hero__author {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .book-hero__author strong {
    color: var(--color-text);
  }

  /* ── Amazon CTA ── */
  .book-hero__badge-row {
    margin-bottom: var(--space-sm);
  }

  .amazon-badge-img {
    height: auto;
    width: 220px;
    max-width: 100%;
