---
/*
 * opendata.astro — Rubrica "Open Data": uso consapevole dei dati pubblici.
 * Elenca gli articoli della collezione blog con series: 'opendata'.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) =>
  !data.draft && data.lang === 'it' && data.series === 'opendata'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const formatDate = (d: Date) =>
  d.toLocaleDateString('it-IT', { year: 'numeric', month: 'long', day: 'numeric' });

const DISCUSSIONS = 'https://github.com/orgs/agent-engineering-studio/discussions';
const NEWSLETTER = 'https://www.linkedin.com/newsletters/agent-engineering-studio-7445502996655800320/';
---

<BaseLayout
  title="Open Data — Agent Engineering Studio"
  description="Una rubrica sull'uso consapevole dei dati pubblici italiani: che cosa misurano davvero, dove possono ingannare, che cosa ci si costruisce. Con codice aperto."
  canonical="https://agentengineering.it/opendata"
>
  <header class="blog-header">
    <div class="container">
      <div class="blog-header__top">
        <a href="/" class="back-link">&larr; Home</a>
      </div>
      <h1 class="blog-title">Open Data</h1>
      <p class="blog-subtitle">Dati pubblici, usati con consapevolezza</p>
    </div>
  </header>

  <main class="container">
    <section class="intro">
      <p>
        L'Italia pubblica ogni giorno dati preziosi, gratis: la pioggia misurata dai radar,
        le statistiche dell'ISTAT, le mappe, i dataset di Regioni e Comuni. Sono stati pagati
        da tutti, e più persone sanno leggerli, più valgono.
      </p>
      <p>
        Ogni puntata di questa rubrica prende un dato pubblico e un progetto open source che
        lo usa, e risponde sempre alle stesse cinque domande, con parole semplici:
      </p>
      <ol class="steps">
        <li><strong>Il dato in breve.</strong> Chi lo pubblica, ogni quanto, per quanto tempo resta disponibile, con quale licenza.</li>
        <li><strong>Che cosa misura davvero.</strong> Come nasce il numero, spiegato senza dare nulla per scontato.</li>
        <li><strong>Dove può ingannare.</strong> Le trappole che abbiamo già incontrato, perché tu non debba scoprirle da solo.</li>
        <li><strong>Che cosa ci costruisci.</strong> Poche righe di codice, un notebook da aprire nel browser, un'idea da riusare.</li>
        <li><strong>I limiti, detti chiaramente.</strong> Che cosa il dato non può dirti, e quale fonte ufficiale non sostituisce.</li>
      </ol>
    </section>

    {posts.length === 0 && (
      <p class="empty">La prima puntata è in arrivo.</p>
    )}

    <ul class="post-list">
      {posts.map(post => (
        <li class="post-card">
          <a href={`/blog/${post.id}`} class="post-card__link">
            <div class="post-card__meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              {post.data.tags.slice(0, 3).map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <h2 class="post-card__title">{post.data.title}</h2>
            <p class="post-card__desc">{post.data.description}</p>
            <span class="post-card__cta">Leggi &rarr;</span>
          </a>
        </li>
      ))}
    </ul>

    <section class="cta">
      <h2>Partecipa</h2>
      <p>
        Conosci un dataset pubblico che merita una puntata? Hai trovato una trappola nei dati
        che usi? Hai un progetto open source costruito su dati aperti? Raccontacelo nelle
        <a href={DISCUSSIONS} target="_blank" rel="noopener noreferrer">discussioni su GitHub</a>.
        Le puntate escono anche nella
        <a href={NEWSLETTER} target="_blank" rel="noopener noreferrer">newsletter LinkedIn</a>.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .blog-header {
    padding: var(--space-2xl) 0 var(--space-xl);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-2xl);
  }

  .blog-header__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-block;
    transition: color var(--transition-fast);
  }
  .back-link:hover { color: var(--color-accent); }

  .lang-switch {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.35em 0.8em;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }
  .lang-switch:hover {
    color: var(--color-accent);
    border-color: rgba(33, 150, 243, 0.4);
  }

  .blog-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .blog-subtitle {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .post-card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color var(--transition-base), transform var(--transition-base);
  }
  .post-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .post-card__link {
    display: block;
    padding: var(--space-xl);
    text-decoration: none;
    color: inherit;
  }

  .post-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-sm);
  }

  .post-card__meta time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .tag {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--color-accent);
    background: rgba(33,150,243,0.1);
    border: 1px solid rgba(33,150,243,0.2);
    border-radius: 4px;
    padding: 2px 6px;
  }

  .post-card__title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
    line-height: 1.3;
  }

  .post-card__desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .post-card__cta {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-2xl) 0;
  }

  .intro {
    max-width: 72ch;
    margin: 0 0 var(--space-2xl);
    color: var(--color-text);
    line-height: 1.8;
    font-size: 1.05rem;
  }
  .intro p { margin-bottom: var(--space-md); }
  .steps { padding-left: var(--space-xl); margin: 0; }
  .steps li { margin-bottom: var(--space-xs); color: var(--color-text-muted); }
  .steps strong { color: var(--color-text); font-weight: 600; }

  .cta {
    max-width: 72ch;
    margin: 0 0 var(--space-2xl);
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    line-height: 1.7;
  }
  .cta h2 {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    margin-bottom: var(--space-sm);
    color: var(--color-text);
  }
  .cta p { color: var(--color-text-muted); margin: 0; }
  .cta a { color: var(--color-accent); text-underline-offset: 3px; }
</style>
